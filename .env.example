# DATABASE
# Local dev (SQLite): DATABASE_URL="file:./dev.db"
# Production (Render PostgreSQL - auto-injected):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mahaleela?sslmode=require"

# AUTH
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# CLOUDINARY (get from cloudinary.com -> Console -> API Keys)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SITE
NEXT_PUBLIC_SITE_URL="https://mahaleela.onrender.com"
NODE_ENV="production"
